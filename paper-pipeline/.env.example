# Copy this file to `.env`, fill in the values, then `source .env` before running.
# NEVER commit your real `.env` — it holds your Discord webhook. (.gitignore blocks it.)

# --- Folders ---------------------------------------------------------------- #
# PDFs and the generated HTML live inside the Google Drive synced folder.
# The database lives OUTSIDE it (local only) — syncing a live SQLite file corrupts it.
export PAPERS_DIR="$PWD/ResearchLibrary/papers"         # replace with your Google Drive path (mounted) or leave as-is for local folder
export OUTPUT_DIR="$PWD/ResearchLibrary/output"         # replace with your Google Drive path (mounted) or leave as-is for local folder
export DB_PATH="$PWD/data/papers.db"                    # you can leave this as-is; it's a local SQLite file
export MARKDOWN_DIR="$PWD/data/markdown"                # you can leave this as-is; it's a local folder for storing paper summaries

# --- Local LLM -------------------------------------------------- #
# Start your local LLM server (LM Studio or Ollama) and set the URL and model name below.
# LM Studio default: http://localhost:1234/v1 (model name can be simply set to "model")
# Ollama default: http://localhost:11434/v1
export LLM_BASE_URL="http://localhost:1234/v1" # your LM Studio/Ollama server URL
export LLM_API_KEY="not-needed"
export LLM_MODEL="model"  # your LM Studio/Ollama model name (ex: qwen3.5:4b)
export LLM_MAX_CHARS="12000"

# --- Discord ---------------------------------------------------------------- #
# Channel -> Edit Channel -> Integrations -> Webhooks -> New Webhook -> Copy URL.
export DISCORD_WEBHOOK_URL=""

# --- Airflow ---------------------------------------------------------------- #
export AIRFLOW_HOME="$PWD/airflow"
export AIRFLOW__CORE__DAGS_FOLDER="$PWD/dags"
export AIRFLOW__CORE__LOAD_EXAMPLES="False"
